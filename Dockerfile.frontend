# ── Frontend Dockerfile ───────────────────────────────────────────────────────
FROM python:3.10-slim

# Copy uv binary from the official image (fast, no extra deps needed)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Install only what the Streamlit frontend needs
RUN uv pip install --system --no-cache streamlit requests

# Copy frontend source
COPY frontend/ ./frontend/

# Default backend URL (overridable via docker-compose env or -e flag)
ENV BACKEND_URL=http://backend:8000

# Expose Streamlit port
EXPOSE 8501

# Disable Streamlit's usage stats & browser auto-open for container use
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_SERVER_HEADLESS=true

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0"]
